// CodeVision Radar — Prisma schema
// Provider: PostgreSQL (Neon / Vercel Postgres, serverless-friendly with connection pooling)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
}

enum LeadStatus {
  novo
  contactar
  contactado
  reuniao
  proposta
  cliente
  nao_interessado
}

enum SearchStatus {
  queued
  running
  done
  error
}

enum SearchStep {
  geocoding
  fetching
  verifying_websites
  scoring
}

enum StepStatus {
  pending
  running
  done
  error
}

enum BusinessSourceType {
  osm
  google_places
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum TicketStatus {
  aberto
  em_atendimento
  resolvido
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  role             Role     @default(member)
  createdAt        DateTime @default(now()) @map("created_at")
  hasPaid          Boolean  @default(false) @map("has_paid")
  stripeCustomerId String?  @map("stripe_customer_id")
  emailVerified    Boolean  @default(false) @map("email_verified")

  leads                   Lead[]
  leadNotes               LeadNote[]
  searches                Search[]
  auditLogs               AuditLog[]
  teamMessages            TeamMessage[]
  teamReminders           TeamReminder[]
  payments                Payment[]
  emailVerificationCodes  EmailVerificationCode[]
  ticketsOpened           Ticket[]      @relation("TicketAuthor")
  ticketsClaimed          Ticket[]      @relation("TicketClaimedBy")
  ticketReplies           TicketReply[]

  @@map("users")
}

/// Código numérico de 6 dígitos enviado por e-mail no cadastro. Guardado
/// com hash (nunca em texto puro) e com expiração curta — o mesmo
/// padrão de segurança usado para senha (ver lib/password.ts).
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

/// Chamado de suporte aberto por qualquer usuário logado (mesmo sem ter
/// pago ainda — é o canal certo pra reportar justamente problemas de
/// pagamento/acesso) com a administração do site.
model Ticket {
  id          String       @id @default(cuid())
  authorId    String       @map("author_id")
  subject     String
  message     String
  status      TicketStatus @default(aberto)
  isRead      Boolean      @default(false) @map("is_read")
  claimedById String?      @map("claimed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  author    User          @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  claimedBy User?         @relation("TicketClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  replies   TicketReply[]

  @@index([status])
  @@index([isRead])
  @@map("tickets")
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticket_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

/// Pagamento único (€2) que libera o acesso aos painéis. O acesso só é
/// concedido (User.hasPaid = true) quando o webhook do Stripe confirma
/// o evento `checkout.session.completed` com assinatura válida — nunca
/// pelo redirect de sucesso no navegador, que pode ser forjado.
model Payment {
  id                      String        @id @default(cuid())
  userId                  String        @map("user_id")
  stripeCheckoutSessionId String        @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?       @map("stripe_payment_intent_id")
  amount                  Int
  currency                String        @default("eur")
  status                  PaymentStatus @default(pending)
  createdAt               DateTime      @default(now()) @map("created_at")
  paidAt                  DateTime?     @map("paid_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

/// Registro de eventos de webhook do Stripe já processados — garante
/// idempotência (o Stripe pode reenviar o mesmo evento mais de uma vez).
model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_webhook_events")
}

model Business {
  id            String   @id @default(cuid())
  name          String
  category      String?
  address       String?
  city          String?
  lat           Float?
  lng           Float?
  phone         String?
  website       String?
  photoUrl      String?  @map("photo_url")
  rating        Float?
  reviewCount   Int?     @map("review_count")
  isIndependent Boolean? @map("is_independent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sources       BusinessSource[]
  leads         Lead[]
  searchResults SearchResult[]

  @@index([city])
  @@index([category])
  @@index([lat, lng])
  @@index([website])
  @@map("businesses")
}

model BusinessSource {
  id         String             @id @default(cuid())
  businessId String             @map("business_id")
  source     BusinessSourceType
  sourceId   String             @map("source_id")
  rawPayload Json               @map("raw_payload")
  fetchedAt  DateTime           @default(now()) @map("fetched_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@map("business_sources")
}

model Lead {
  id             String     @id @default(cuid())
  businessId     String     @map("business_id")
  ownerId        String?    @map("owner_id")
  status         LeadStatus @default(novo)
  potentialValue Float?     @map("potential_value")
  contactDate    DateTime?  @map("contact_date")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  notes    LeadNote[]
  tags     LeadTag[]

  @@index([status])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String   @map("lead_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("lead_notes")
}

model LeadTag {
  id     String @id @default(cuid())
  leadId String @map("lead_id")
  tag    String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_tags")
}

model Search {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  location   String
  radiusKm   Float        @map("radius_km")
  category   String?
  keyword    String?
  status     SearchStatus @default(queued)
  step       SearchStep   @default(geocoding)
  progress   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at")
  finishedAt DateTime?    @map("finished_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  results SearchResult[]

  @@index([createdAt])
  @@map("searches")
}

model SearchResult {
  id         String @id @default(cuid())
  searchId   String @map("search_id")
  businessId String @map("business_id")

  search   Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([searchId, businessId])
  @@map("search_results")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

/// Mural/chat interno da equipe (página Equipe).
model TeamMessage {
  id        String   @id @default(cuid())
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("team_messages")
}

/// Lembretes/tarefas rápidas ("prompts") que qualquer membro da equipe
/// pode criar e marcar como concluído.
model TeamReminder {
  id        String    @id @default(cuid())
  authorId  String    @map("author_id")
  content   String
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([done])
  @@map("team_reminders")
}
